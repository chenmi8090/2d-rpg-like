[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/equipment/equipment_definition.gd" id="1_equipment"]
[ext_resource type="Script" path="res://scripts/progression/stat_modifier.gd" id="2_modifier"]
[ext_resource type="Resource" path="res://resources/combat/player_attacks/sword_light.tres" id="3_light"]
[ext_resource type="Resource" path="res://resources/combat/player_attacks/sword_heavy.tres" id="4_heavy"]

[sub_resource type="Resource" id="Strength"]
script = ExtResource("2_modifier")
stat_key = &"strength"
flat_bonus = 2.0

[sub_resource type="Resource" id="Attack"]
script = ExtResource("2_modifier")
stat_key = &"physical_attack"
flat_bonus = 2.0

[resource]
script = ExtResource("1_equipment")
id = &"tempered_sword"
display_name = "精炼长剑"
slot = &"weapon"
weapon_type = &"sword"
light_attack_profile = ExtResource("3_light")
heavy_attack_profile = ExtResource("4_heavy")
