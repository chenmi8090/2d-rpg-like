[gd_resource type="Resource" script_class="EquipmentDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/equipment/equipment_definition.gd" id="1_equipment"]
[ext_resource type="Script" path="res://scripts/progression/stat_modifier.gd" id="2_modifier"]

[sub_resource type="Resource" id="Technique"]
script = ExtResource("2_modifier")
stat_key = &"technique"
flat_bonus = 2.0

[sub_resource type="Resource" id="Attack"]
script = ExtResource("2_modifier")
stat_key = &"physical_attack"
flat_bonus = 2.0

[resource]
script = ExtResource("1_equipment")
id = &"hunter_bow"
display_name = "猎手短弓"
slot = &"weapon"
weapon_type = &"bow"
modifiers = Array[ExtResource("2_modifier")]([SubResource("Technique"), SubResource("Attack")])
