[ext_resource type="Script" path="res://scripts/world/portal_definition.gd" id="3"]
[ext_resource type="Resource" path="res://resources/encounters/field_passage_3_encounter.tres" id="4"]

[sub_resource type="Resource" id="EntryFrom1"]
script = ExtResource("2")
id = &"from_field_passage_1"
